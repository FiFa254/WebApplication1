# Copy to .env and fill in. Never commit .env.

# Password for the PostgreSQL container (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Admin account for adding / editing / deleting profiles.
ADMIN_USERNAME=admin
# Generate with:  docker compose build app && docker run --rm devfolio:latest hash-password 'YourStrongPassword'
# (or locally:    dotnet run -- hash-password 'YourStrongPassword')
ADMIN_PASSWORD_HASH=

# Host port for the web app.
APP_PORT=8080

# true only when a reverse proxy sits in front of the app and the app port is not public.
FORWARDED_HEADERS=false
