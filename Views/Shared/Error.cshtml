@model ErrorViewModel
@{
    var statusCode = Context.Response.StatusCode;
    var (title, message) = statusCode switch
    {
        404 => ("Page not found", "The page you are looking for does not exist or was removed."),
        429 => ("Too many requests", "Please wait a minute and try again."),
        _ => ("Something went wrong", "An error occurred while processing your request. Please try again later.")
    };
    ViewData["Title"] = title;
}

<section class="page-header">
    <h1>@title</h1>
    <p>@message</p>
</section>

@if (Model?.ShowRequestId == true)
{
    <p class="text-muted-soft">Request ID: <code>@Model.RequestId</code></p>
}

<p class="mt-4">
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Home</a>
</p>
