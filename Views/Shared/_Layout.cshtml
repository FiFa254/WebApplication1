<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevFolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-container site-header-inner">
            <a class="site-brand" asp-controller="Home" asp-action="Index">
                <span class="site-brand-mark">D</span>
                <span class="site-brand-text">DevFolio</span>
            </a>

            <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="site-nav" id="siteNav">
                <a class="site-nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <a class="site-nav-link" asp-controller="Home" asp-action="Profiles">Profiles</a>
                <a class="site-nav-link" asp-controller="Home" asp-action="Projects">Projects</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="site-nav-link site-nav-cta" asp-controller="Home" asp-action="AddProfile">Add Profile</a>
                    <form class="site-nav-form" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="site-nav-link site-nav-button">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="site-nav-link" asp-controller="Account" asp-action="Login">Admin</a>
                }
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="site-container">
            @if (TempData["Status"] is string status)
            {
                <div class="status-message" role="status">@status</div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-container site-footer-inner">
            <p>&copy; @DateTime.UtcNow.Year DevFolio</p>
            <p class="site-footer-muted">Built with ASP.NET Core MVC</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
