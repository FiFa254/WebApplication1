<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Basic CRUD and Grant Permission</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <nav class="app-header">
        <button class="sidebar-toggle" id="toggleSidebar" type="button" aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div>
            <span class="app-eyebrow">Basic CRUD</span>
            <h1 class="app-title">@ViewData["Title"]</h1>
        </div>
    </nav>

    <div class="app-shell">
        <aside id="sidebar" class="app-sidebar">
            <div class="sidebar-brand">W1</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <span class="sidebar-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                                <path d="M8 3.293l6 6V14a1 1 0 0 1-1 1h-3v-3H6v3H3a1 1 0 0 1-1-1v-4.707l6-6z" />
                            </svg>
                        </span>
                        <span class="sidebar-text">Home</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="AddProfile">
                        <span class="sidebar-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                                <path d="M8 1a4 4 0 0 1 3.46 6.01A6.99 6.99 0 0 1 15 13v1H1v-1a6.99 6.99 0 0 1 3.54-5.99A4 4 0 0 1 8 1z" />
                            </svg>
                        </span>
                        <span class="sidebar-text">Add Profile</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">
                        <span class="sidebar-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                                <path d="M2 2h12v12H2z" />
                            </svg>
                        </span>
                        <span class="sidebar-text">Projects</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Permission">
                        <span class="sidebar-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                                <path d="M8 1a4 4 0 0 1 4 4v2h1a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V5a4 4 0 0 1 4-4z" />
                            </svg>
                        </span>
                        <span class="sidebar-text">Permission</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Stock" asp-action="Index">
                        <span class="sidebar-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                                <path d="M3 2h10l1 3v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5l1-3zm1 4v6h8V6H4zm1-3-.4 1h6.8L11 3H5z" />
                            </svg>
                        </span>
                        <span class="sidebar-text">Stock Watch</span>
                    </a>
                </li>
            </ul>
        </aside>

        <div id="content" class="app-content">
            <main class="content-panel">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
