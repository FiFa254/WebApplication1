@{
    ViewData["Title"] = "Shopee Stock Watch";
}

<section class="page-hero stock-hero">
    <div>
        <h1>Shopee Stock Watch</h1>
        <p>Add Shopee products, check availability on demand, and let this web application check once per day.</p>
    </div>
    <button id="stockNotifyButton" class="btn btn-outline-secondary" type="button">Notify</button>
</section>

<section class="modern-card stock-panel">
    <form id="stockAddForm" class="stock-form">
        <div class="form-group">
            <label for="stockName">Product name</label>
            <input id="stockName" class="form-control" name="name" placeholder="Headphones, keyboard, limited item" required />
        </div>
        <div class="form-group stock-url-field">
            <label for="stockUrl">Shopee URL</label>
            <input id="stockUrl" class="form-control" name="url" placeholder="https://shopee.co.th/..." required />
        </div>
        <button class="btn btn-primary" type="submit">Add</button>
    </form>
</section>

<section class="stock-toolbar">
    <button id="stockCheckButton" class="btn btn-primary" type="button">Check now</button>
    <p id="stockSummary" class="text-muted-soft mb-0">Loading...</p>
</section>

<section id="stockItems" class="stock-items"></section>

<section class="modern-card">
    <h2 class="h5 mb-3">Recent activity</h2>
    <div id="stockEvents" class="stock-events"></div>
</section>

@section Scripts {
    <script src="~/js/stock-watch.js" asp-append-version="true"></script>
}
