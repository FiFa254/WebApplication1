@model WebApplication1.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile Saved";
}

<section class="page-header">
    <h1>Profile Saved</h1>
    <p>Your profile has been added to the portfolio showcase.</p>
</section>

<div class="confirm-card">
    <h2>Success!</h2>
    <p><strong>Name:</strong> @Model.FirstName @Model.LastName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    @if (!string.IsNullOrWhiteSpace(Model.Bio))
    {
        <p><strong>Bio:</strong> @Model.Bio</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
    {
        <p><strong>Profile Image:</strong></p>
        <img src="@Model.ProfileImagePath" alt="@Model.FirstName @Model.LastName" class="profile-preview-image" />
    }

    @if (Model.Projects.Any())
    {
        <hr style="border-color: var(--border); margin: 1.25rem 0;" />
        <h3 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 0.75rem;">Projects (@Model.Projects.Count)</h3>
        @foreach (var project in Model.Projects)
        {
            <div class="saved-project">
                <p><strong>@project.ProjectName</strong></p>
                @if (!string.IsNullOrWhiteSpace(project.Description))
                {
                    <p>@project.Description</p>
                }
                @if (!string.IsNullOrWhiteSpace(project.GithubLink))
                {
                    <p><a href="@project.GithubLink" target="_blank" rel="noopener">@project.GithubLink</a></p>
                }
            </div>
        }
    }
</div>

<div class="hero-actions mt-4">
    <a class="btn btn-primary" asp-action="Profiles">View All Profiles</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Home</a>
</div>
