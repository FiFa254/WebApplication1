@model WebApplication1.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile Saved";
}

<section class="page-hero">
    <div>
        <h2>Profile Saved</h2>
        <p>The profile has been saved successfully.</p>
    </div>
</section>

<div class="card">
    <div class="card-body">
        <p><strong>First Name:</strong> @Model.FirstName</p>
        <p><strong>Last Name:</strong> @Model.LastName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Bio:</strong> @Model.Bio</p>
        @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
        {
            <p><strong>Profile Image:</strong></p>
            <img src="@Model.ProfileImagePath" alt="@Model.FirstName @Model.LastName" class="profile-preview-image" />
        }

        @if (Model.Projects.Any())
        {
            <hr />
            <h3 class="h5">Projects</h3>
            @foreach (var project in Model.Projects)
            {
                <div class="saved-project">
                    <p><strong>Project Name:</strong> @project.ProjectName</p>
                    <p><strong>Description:</strong> @project.Description</p>
                    <p><strong>GitHub Link:</strong> <a href="@project.GithubLink" target="_blank" rel="noopener">@project.GithubLink</a></p>
                </div>
            }
        }
    </div>
</div>

<p class="mt-3"><a class="btn btn-primary" asp-action="Index">Back to Home</a></p>
