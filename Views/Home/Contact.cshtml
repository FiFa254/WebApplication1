@model IEnumerable<WebApplication1.Models.ProfileProject>

@{
    ViewData["Title"] = "Projects";
}

<section class="page-hero">
    <div>
        <h1>Projects</h1>
        <p>Browse the project portfolio collected from saved profiles.</p>
    </div>
</section>

@if (!Model.Any())
{
    <section class="modern-card">
        <h2 class="h5 mb-2">No projects yet</h2>
        <p class="text-muted-soft mb-0">Add a profile with project details to show work here.</p>
    </section>
}
else
{
    <section class="project-gallery">
        @foreach (var project in Model)
        {
            <article class="project-card">
                @if (!string.IsNullOrWhiteSpace(project.Profile?.ProfileImagePath))
                {
                    <img src="@project.Profile.ProfileImagePath" alt="@project.Profile.FirstName @project.Profile.LastName" class="project-card-image" />
                }
                else
                {
                    <div class="project-card-placeholder">No Image</div>
                }

                <div class="project-card-body">
                    <h2>@project.ProjectName</h2>
                    <p>@project.Description</p>

                    @if (project.Profile is not null)
                    {
                        <p class="project-owner">By @project.Profile.FirstName @project.Profile.LastName</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(project.GithubLink))
                    {
                        <a class="btn btn-primary" href="@project.GithubLink" target="_blank" rel="noopener">View GitHub</a>
                    }
                </div>
            </article>
        }
    </section>
}
